# Alleen server-side (Netlify Edge Function / Vite dev-server). Nooit in de browser.
OPENAI_API_KEY=
# Optioneel
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=none
# Komma-gescheiden hostnamen die de scanner mogen aanroepen (* = wildcard-prefix)
ALLOWED_HOSTS=ppp.larsschrijvers.be,prijs-per-promille.netlify.app,*--prijs-per-promille.netlify.app,localhost,127.0.0.1
